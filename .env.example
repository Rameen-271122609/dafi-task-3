# ---------------------------------------------------------------------------
# MediTrack environment
# Copy to .env.local for development, or /var/www/meditrack/.env on the server.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser-safe key. New projects issue a publishable key; older ones issue
# an anon key. Set whichever your project shows — the app reads both names and
# prefers the publishable one. Neither grants access beyond row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Absolute origin the app is served from. Used for metadata and the links
# Supabase puts in confirmation emails.
NEXT_PUBLIC_SITE_URL=https://meditrack.example.com

# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
