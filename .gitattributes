# Normalise line endings so files checked out on Windows still run on Linux.
* text=auto eol=lf

# Shell scripts and server configuration must never carry CRLF.
*.sh      text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.pdf     binary
